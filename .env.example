# MongoDB
MONGODB_URI=mongodb://localhost:27017/elizabeth-sarah

# Iron Session (must be at least 32 characters)
IRON_SESSION_PASSWORD=complex_password_at_least_32_characters_long_for_security

# JWT Secret (must be at least 32 characters)
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long

# Bcrypt Salt Rounds
BCRYPT_SALT_ROUNDS=10

# Environment
NODE_ENV=development

# Mail Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@example.com

# Domain
NEXT_PUBLIC_SITE_URL=localhost:8084

# API URLs
NEXT_PUBLIC_API_URL=http://localhost:8084/api
NEXT_PUBLIC_IMAGE_SERVER=http://localhost:8084

# Next.js
NEXT_PUBLIC_HOST_API=http://localhost:8084
